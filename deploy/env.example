# OCI API authentication
OCI_CONFIG_FILE=/etc/oci-instance-automation/config
OCI_PROFILE=DEFAULT
# Must be the tenancy's home region for Always Free resources.
OCI_REGION=ap-singapore-1

# Target resources (Console -> Compute -> Instances / Networking -> VCN -> Subnets)
COMPARTMENT_OCID=ocid1.compartment.oc1..REPLACE_ME
SUBNET_OCID=ocid1.subnet.oc1.ap-singapore-1..REPLACE_ME
SSH_PUBLIC_KEY_FILE=/etc/oci-instance-automation/id_ed25519.pub

INSTANCE_NAME=free-a1
SHAPE=VM.Standard.A1.Flex

# Always Free caps: 2 OCPU, 12 GB, 200 GB total block storage. Do not raise these.
OCPUS=2
MEMORY_GB=12
BOOT_VOLUME_GB=199

# 10 = Balanced, 20 = Higher Performance (default), 30-120 = Ultra High.
# 20 is the fastest normal tier. Ultra High is allowed by the program but may be billed.
# Always Free covers the 200 GB of storage; VPU performance is metered separately. If you
# need a guaranteed-zero bill, set 10 and check the console cost estimate before starting.
BOOT_VOLUME_VPUS=20

# Platform image discovery. The newest matching aarch64 image is used.
IMAGE_OS="Canonical Ubuntu"
IMAGE_VERSION=26.04
# Pin an exact image instead of discovering one:
# IMAGE_OCID=ocid1.image.oc1.ap-singapore-1..REPLACE_ME

# Leave unset to rotate across every availability domain in the region.
# AVAILABILITY_DOMAIN=REPLACE_ME:AP-SINGAPORE-1-AD-1
# FAULT_DOMAIN=FAULT-DOMAIN-1
# NSG_IDS=ocid1.networksecuritygroup.oc1.ap-singapore-1..REPLACE_ME

ASSIGN_PUBLIC_IP=true

# 60 seconds between launch attempts; exponential backoff on HTTP 429/5xx, capped here.
ATTEMPT_INTERVAL_SECONDS=60
MAX_BACKOFF_SECONDS=1800
# 0 = retry forever.
MAX_ATTEMPTS=0
